import React, { useState } from 'react';
import { LabProject } from '../../types/carousel';
import { EffectSettings } from '../dev/DevPanel';

interface EnhancedLabTileProps {
  project: LabProject;
  index: number;
  isActive: boolean;
  transform: string;
  effects: EffectSettings;
  onClick?: () => void;
  onFocus?: () => void;
  onBlur?: () => void;
}

export function EnhancedLabTile({ 
  project, 
  index, 
  isActive, 
  transform, 
  effects,
  onClick, 
  onFocus, 
  onBlur 
}: EnhancedLabTileProps) {
  const [imageLoaded, setImageLoaded] = useState(false);
  const [imageError, setImageError] = useState(false);

  const handleImageLoad = () => {
    setImageLoaded(true);
  };

  const handleImageError = () => {
    setImageError(true);
  };

  const handleKeyDown = (event: React.KeyboardEvent) => {
    if (event.key === 'Enter' || event.key === ' ') {
      event.preventDefault();
      onClick?.();
    }
  };

  // Dynamic classes based on effects
  const tileClasses = `
    lab-tile absolute cursor-pointer transition-all duration-300 ease-out
    ${effects.monitorStyle ? 'w-40 h-25' : 'w-40 h-25'}
    ${effects.curvedPanels ? 'curved' : ''}
    ${effects.monitorStyle && effects.curvedPanels ? 'monitor-curved' : ''}
    ${isActive ? 'lab-tile--active' : ''}
    ${effects.screenGlow ? 'screen-glow' : ''}
  `;

  const containerClasses = `
    relative w-full h-full transition-all duration-300
    ${effects.monitorStyle 
      ? 'bg-gray-900 border-4 border-gray-600 shadow-2xl' // Monitor style
      : 'bg-gray-900/80 backdrop-blur-sm border border-gray-700/50 rounded-lg shadow-2xl' // Card style
    }
    ${effects.screenGlow 
      ? 'shadow-cyan-500/20 border-cyan-500/30' 
      : 'hover:shadow-cyan-500/20 hover:border-cyan-500/30'
    }
    focus:outline-none focus:ring-2 focus:ring-cyan-500/50
    overflow-hidden
  `;

  return (
    <div
      className={tileClasses}
      style={{ transform }}
      onClick={handleClick}
      onKeyDown={handleKeyDown}
      tabIndex={0}
      role="button"
      aria-label={`Project: ${project.title}`}
      aria-describedby={`project-desc-${project.id}`}
    >
      <div className="tile-content w-full h-full">
        <div className={containerClasses}>
            {/* Monitor Style Bezel */}
            {effects.monitorStyle && (
              <div className="absolute inset-0 bg-gradient-to-br from-gray-700 via-gray-800 to-gray-900 rounded-sm">
                <div className="absolute inset-2 bg-black rounded-sm overflow-hidden">
                  {/* Screen content goes here */}
                </div>
              </div>
            )}

          {/* Image Container */}
        <div className={`
          relative overflow-hidden
          ${effects.monitorStyle ? 'absolute inset-2 rounded-sm' : 'w-full h-2/3'}
        `}>
          {!imageError ? (
            <>
              <img
                src={project.imageUrl}
                alt={project.title}
                className={`
                  w-full h-full object-cover transition-all duration-500
                  ${imageLoaded ? 'opacity-100 scale-100' : 'opacity-0 scale-110'}
                  ${effects.scanLines ? 'scan-lines' : ''}
                `}
                onLoad={handleImageLoad}
                onError={handleImageError}
                loading="lazy"
              />
              {!imageLoaded && (
                <div className="absolute inset-0 bg-gray-800 animate-pulse flex items-center justify-center">
                  <div className="w-8 h-8 border-2 border-cyan-500 border-t-transparent rounded-full animate-spin" />
                </div>
              )}
            </>
          ) : (
            <div className="w-full h-full bg-gradient-to-br from-gray-800 to-gray-900 flex items-center justify-center">
              <div className="text-gray-500 text-center">
                <div className="w-12 h-12 mx-auto mb-2 opacity-50">
                  <svg fill="currentColor" viewBox="0 0 20 20">
                    <path fillRule="evenodd" d="M4 3a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V5a2 2 0 00-2-2H4zm12 12H4l4-8 3 6 2-4 3 6z" clipRule="evenodd" />
                  </svg>
                </div>
                <p className="text-xs">Image unavailable</p>
              </div>
            </div>
          )}
          
          {/* Category Badge */}
          <div className={`
            absolute top-3 left-3
            ${effects.monitorStyle ? 'top-1 left-1' : ''}
          `}>
            <span className={`
              px-2 py-1 text-xs font-medium backdrop-blur-sm
              ${effects.monitorStyle 
                ? 'bg-cyan-500/30 text-cyan-200 border border-cyan-400/50' 
                : 'bg-cyan-500/20 text-cyan-300 border border-cyan-500/30'
              }
              rounded-full
            `}>
              {project.category}
            </span>
          </div>

          {/* Year Badge */}
          <div className={`
            absolute top-3 right-3
            ${effects.monitorStyle ? 'top-1 right-1' : ''}
          `}>
            <span className={`
              px-2 py-1 text-xs font-medium backdrop-blur-sm
              ${effects.monitorStyle
                ? 'bg-gray-800/80 text-gray-200 border border-gray-600/50'
                : 'bg-gray-900/60 text-gray-300 border border-gray-600/50'
              }
              rounded-full
            `}>
              {project.year}
            </span>
          </div>

          {/* Scan Lines Effect */}
          {effects.scanLines && (
            <div className="absolute inset-0 pointer-events-none scan-lines-overlay" />
          )}
        </div>

        {/* Content Container - Only show if not in monitor mode or adjust positioning */}
        {!effects.monitorStyle && (
          <div className="p-2 h-1/3 flex flex-col justify-center">
            <h3 className="text-xs font-semibold text-white text-center line-clamp-1">
              {project.title}
            </h3>
          </div>
        )}

            {/* Technologies */}
            {project.technologies && project.technologies.length > 0 && (
              <div className="flex flex-wrap gap-1 mt-2">
                {project.technologies.slice(0, 3).map((tech, techIndex) => (
                  <span
                    key={techIndex}
                    className="px-2 py-0.5 text-xs bg-gray-800/60 text-gray-400 border border-gray-700/50 rounded"
                  >
                    {tech}
                  </span>
                ))}
                {project.technologies.length > 3 && (
                  <span className="px-2 py-0.5 text-xs text-gray-500">
                    +{project.technologies.length - 3}
                  </span>
                )}
              </div>
            )}
          </div>
        )}

        {/* Monitor Mode - Overlay Info */}
        {effects.monitorStyle && (
          <div className="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/80 to-transparent p-3">
            <h3 className="text-sm font-semibold text-white mb-1">
              {project.title}
            </h3>
            <p className="text-xs text-gray-300 line-clamp-1">
              {project.description}
            </p>
          </div>
        )}

        {/* Screen Glow Effect */}
        {effects.screenGlow && (
          <div className="absolute inset-0 pointer-events-none screen-glow-effect" />
        )}
        </div>
      </div>
    </div>
  );
}

